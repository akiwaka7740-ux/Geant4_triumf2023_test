/run/initialize

/analysis/neutronHistoryTarget LiGlass
/analysis/opticalRecording off

# 一次粒子：1 event あたり中性子を1個生成
/gps/particle neutron
/gps/number 1

# 発生位置：原点の点線源
/gps/pos/type Point
/gps/pos/centre 0 0 0 mm

# 運動エネルギー：
/gps/ene/type Mono
/gps/ene/mono 0.1 MeV

# 放出方向：等方
/gps/ang/type iso

/run/printProgress 1000000
/run/beamOn 500000000